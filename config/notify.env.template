# Codex Telegram Bridge notification secrets.
# Copy to .secrets/notify.env and fill values there. Do not commit real tokens.

# Telegram first-choice destination.
# Create a bot with BotFather, start a chat with it, and set the chat id.
TELEAGENT_BOT_TOKEN=
TELEAGENT_CHAT_ID=
# Optional group-chat support: owner numeric user id and bot username.
# When set, the bot accepts group messages addressed to @BOT_USERNAME from
# chats where the owner is a member; the owner's own group messages also count.
TELEAGENT_OWNER_USER_ID=
TELEAGENT_BOT_USERNAME=

# Optional email fallback. Used when Telegram is missing or fails.
TELEAGENT_SMTP_HOST=
TELEAGENT_SMTP_PORT=587
TELEAGENT_SMTP_USER=
TELEAGENT_SMTP_PASSWORD=
TELEAGENT_SMTP_FROM=
TELEAGENT_SMTP_TO=
TELEAGENT_SMTP_STARTTLS=1
TELEAGENT_SMTP_SSL=0

# Notification policy.
# Keep images off by default so unreviewed outputs are not pushed remotely.
TELEAGENT_NOTIFY_ALLOW_IMAGES=0
TELEAGENT_NOTIFY_ALLOW_FILES=0
TELEAGENT_NOTIFY_MAX_UPLOAD_MB=20
TELEAGENT_NOTIFY_LOG_JSONL=logs/readable/notifications.jsonl
TELEAGENT_REPORT_INTERVAL_SECONDS=1800
TELEAGENT_INBOX_TARGET=tele-agent:0.0
TELEAGENT_CODEX_WINDOW=codex
TELEAGENT_INBOX_MODE=tmux-enter
