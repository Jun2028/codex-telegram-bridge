# Minimal Telegram/Codex relay environment (copy to config/relay.env).

export TELEAGENT_SCRATCH="${TELEAGENT_SCRATCH:-$HOME/.local/share/tele-agent}"
export TELEAGENT_LOG_DIR="${TELEAGENT_LOG_DIR:-$TELEAGENT_SCRATCH/runtime}"
export TELEAGENT_AGENT_DIR="${TELEAGENT_AGENT_DIR:-$TELEAGENT_LOG_DIR/agents}"
# Main Codex home. Non-main instances default to their own
# $TELEAGENT_SCRATCH/codex-home and may not point back at this directory.
export TELEAGENT_CODEX_HOME="${TELEAGENT_CODEX_HOME:-$HOME/.codex}"
export TELEAGENT_CODEX_MODEL="${TELEAGENT_CODEX_MODEL:-deepseek-v4-flash}"
export TELEAGENT_CODEX_REASONING_EFFORT="${TELEAGENT_CODEX_REASONING_EFFORT:-max}"
# Keep unattended agents input-ready. Update the managed CLI during maintenance.
export TELEAGENT_CODEX_CHECK_FOR_UPDATE_ON_STARTUP="${TELEAGENT_CODEX_CHECK_FOR_UPDATE_ON_STARTUP:-false}"
# Per-instance access policy. Keep the default for coding agents. Set this only
# in config/relay-<instance>.env to make that bot conversational only: it gets
# an empty work directory, deny-all command filesystem/network permissions,
# and no shell, web, browser, app, plugin, connector, image, or sub-agent tools.
export TELEAGENT_CODEX_ACCESS_MODE="${TELEAGENT_CODEX_ACCESS_MODE:-full-access}"
# Set to 1 in config/relay-<instance>.env to stop the listener from appending
# the trailing ∎ marker to that instance's final answers.
export TELEAGENT_SUPPRESS_FINAL_MARKER="${TELEAGENT_SUPPRESS_FINAL_MARKER:-0}"
# Set to 1 to require an @<bot-username> mention before an owner's group
# message is relayed. Useful when several tele-agent bots share one group.
export TELEAGENT_REQUIRE_GROUP_MENTION="${TELEAGENT_REQUIRE_GROUP_MENTION:-1}"
# Group replay records are always separate. Set to 1 to also keep private
# chat records outside the operational audit log. All chats still share this
# instance's one Codex conversation.
export TELEAGENT_PER_CHAT_INBOX_RECORDS="${TELEAGENT_PER_CHAT_INBOX_RECORDS:-0}"
# Set to 1 for bounded per-person continuity in private chat. Group prompts
# never receive this private memory summary.
export TELEAGENT_PEOPLE_MEMORY="${TELEAGENT_PEOPLE_MEMORY:-0}"
# Optional colon-separated path fragments that must never hold relay state.
# export TELEAGENT_BLOCKED_PATH_FRAGMENTS="/shared:/group-storage"
# Mode-0600 file created by scripts/bootstrap_new_machine.sh.
export TELEAGENT_DS_KEY_FILE="${TELEAGENT_DS_KEY_FILE:-$HOME/.config/tele-agent/deepseek.env}"
export PYTHONUNBUFFERED=1
