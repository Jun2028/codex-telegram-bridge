# Minimal Telegram/Codex relay environment (copy to config/relay.env).

export TELEAGENT_SCRATCH="${TELEAGENT_SCRATCH:-$HOME/.local/share/tele-agent}"
export TELEAGENT_LOG_DIR="${TELEAGENT_LOG_DIR:-$TELEAGENT_SCRATCH/runtime}"
export TELEAGENT_AGENT_DIR="${TELEAGENT_AGENT_DIR:-$TELEAGENT_LOG_DIR/agents}"
export TELEAGENT_CODEX_MODEL="${TELEAGENT_CODEX_MODEL:-deepseek-v4-flash}"
export TELEAGENT_CODEX_REASONING_EFFORT="${TELEAGENT_CODEX_REASONING_EFFORT:-max}"
# Optional colon-separated path fragments that must never hold relay state.
# export TELEAGENT_BLOCKED_PATH_FRAGMENTS="/shared:/group-storage"
# Mode-0600 file created by scripts/bootstrap_new_machine.sh.
export TELEAGENT_DS_KEY_FILE="${TELEAGENT_DS_KEY_FILE:-$HOME/.config/tele-agent/deepseek.env}"
export PYTHONUNBUFFERED=1
